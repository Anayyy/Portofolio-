# Normalize text files to LF in the repository; checkout follows the user's Git settings.
* text=auto

# Keep web source and documentation normalized across operating systems.
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.txt text eol=lf

# Image assets are binary; never run text or line-ending conversions on them.
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
